{
  "name": "dsh-session-categories",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "会话分类：把会话划入分类、在分类下新建会话、AI 自动分类",
  "license": "MIT",
  "author": "CleverYyt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CleverYyt/dsh-session-categories.git"
  },
  "homepage": "https://github.com/CleverYyt/dsh-session-categories#readme",
  "bugs": {
    "url": "https://github.com/CleverYyt/dsh-session-categories/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-client-plugin",
    "session",
    "categories",
    "sidebar",
    "ai",
    "i18n"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-0 <0.3.0-0"
  },
  "scripts": {
    "check": "node scripts/check-host.mjs && node scripts/smoke-client.mjs",
    "check:host": "node scripts/check-host.mjs",
    "check:client": "node scripts/smoke-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
